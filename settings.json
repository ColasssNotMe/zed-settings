// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "reduce_motion": "on",
  "redact_private_values": false,
  "language_models": {
    "openai_compatible": {
      "9router": {
        "api_url": "http://localhost:20128/v1",
        "available_models": [
          {
            "name": "premium_model",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
  },
  "format_on_save": "on",
  "agent_servers": {
    "gemini": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "off",
      },
      "type": "registry",
    },
  },
  "context_servers": {
    "stitch": {
      "enabled": true,
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6LzFh1elK0b6n4FuFBLmQ9Bbe0uH3u1dDsxa8_r4jKWDQ",
      },
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "languages": {
    "Java": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": true,
      },
    },
    "C++": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["--style=file", "--fallback-style=LLVM"],
        },
      },
    },
  },
  "prettier": {
    "allowed": true,
  },
  "file_types": {
    "HTML": ["svg"],
  },

  "window_decorations": "client",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
  },
  "toolbar": {
    "code_actions": true,
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "buffer_font_family": "JetBrains Mono",
  "preferred_line_length": 75,
  "relative_line_numbers": "enabled",
  "show_edit_predictions": false,
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
    "font_family": ".ZedMono",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "max_output_tokens": 60,
      "model": "deepseek:v4@flash",
      "api_url": "https://api.runware.ai/v1",
    },
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
    },
    "provider": "copilot",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
    "enabled_in_text_threads": false,
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": false,
    "indent_guides": {
      "show": "always",
    },
    "indent_size": 15.0,
    "auto_fold_dirs": false,
    "dock": "right",
  },
  "soft_wrap": "editor_width",
  "agent": {
    "sandbox_permissions": {
      "network_hosts": ["capgo.dev"],
    },
    "tool_permissions": {
      "default": "allow",
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "profiles": {
      "agent": {
        "name": "Agent",
        "tools": {
          "skill": true,
          "fetch": true,
          "thinking": true,
          "terminal": true,
          "read_file": true,
          "open": true,
          "now": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "copy_path": true,
          "diagnostics": true,
          "edit_file": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "default_profile": "ask",
    "dock": "right",
    "model_parameters": [],
    "default_model": {
      "enable_thinking": false,
      "provider": "9router",
      "model": "premium_model",
    },
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Kanagawa Lotus",
    "dark": "0x96f Theme",
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
}
